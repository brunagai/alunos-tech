# Copie este arquivo para .env e substitua cada CHANGE_ME.
# O arquivo .env fica na máquina local e não deve ser commitado.

# PostgreSQL — lidas pelo serviço db do docker-compose.yml
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=CHANGE_ME
# Porta publicada apenas em 127.0.0.1, para ferramentas no host (DBeaver, psql).
POSTGRES_PORT=5432

# API .NET 8 — uso futuro, quando o serviço da API for adicionado ao Compose.
# Dentro da rede alunostech o host do banco é o nome do serviço: db
ASPNETCORE_ENVIRONMENT=Development
API_HTTP_PORT=8080
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=CHANGE_ME;Username=CHANGE_ME;Password=CHANGE_ME

# Chave simétrica do JWT. Use um valor longo e aleatório (32+ caracteres).
JWT_SIGNING_KEY=CHANGE_ME
JWT_ISSUER=CHANGE_ME
JWT_AUDIENCE=CHANGE_ME
